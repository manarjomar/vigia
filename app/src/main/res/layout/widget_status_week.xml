<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_surface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/status_dial"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
        android:id="@+id/status_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
        android:textSize="13sp"
        android:textStyle="bold" />

            <TextView
        android:id="@+id/status_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text"
        android:textSize="40sp"
        android:fontFamily="sans-serif-medium" />

            <TextView
        android:id="@+id/status_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
        android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_day_0"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_row_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_none"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_day_1"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_row_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_none"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_day_2"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_row_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_none"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_day_3"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_row_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_none"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_day_4"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_row_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_none"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_day_5"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_row_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_none"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/week_day_6"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_row_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_none"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:shadowColor="@color/widget_shadow"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/status_refresh"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/app_name"
        android:padding="3dp"
        android:src="@drawable/ic_widget_refresh" />
</FrameLayout>
</FrameLayout>
